#cloud-config
autoinstall:
  version: 1
  interactive-sections: []
  source:
    id: ubuntu-server-minimal
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: tzmcp-appliance
    username: ${build_username}
    realname: tzMCP Build User
    password: ${build_password_hash}
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
    swap:
      size: 0
  updates: all
  late-commands:
    - curtin in-target --target=/target -- systemctl enable ssh
